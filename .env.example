# SMB Commerce Operations Agent — environment
#
# The headline model provider is the Meta Model API (Muse Spark).
# Hosted profiles FAIL CLOSED: selecting one without its key raises at
# wiring time. There is no silent fallback to another provider.

# --- Meta Model API (Muse Spark) -------------------------------------
# Self-serve key from dev.meta.ai. Required only for the meta-muse
# profile; the blueprint runs fully offline without it.
META_MODEL_API_KEY=
# OpenAI-compatible base URL of the Meta Model API.
META_MODEL_API_BASE_URL=https://api.meta.ai/v1
# Model identifier. Configurable because identifiers evolve; the
# default names the Muse Spark standard tier as documented at
# dev.meta.ai. Confirm the current identifier before a live run.
META_MUSE_MODEL=muse-spark
# Model profile: offline (default, deterministic) or meta-muse.
SMB_MODEL_PROFILE=offline
# Tier discipline (Law 6): standard is the default and Meta does not
# train on standard-tier data. contributor is far cheaper, but Meta may
# train on prompts and outputs sent to it — select it explicitly, and
# it is stamped on every call record.
META_MUSE_TIER=standard

# --- Data plane -------------------------------------------------------
# SQLite is the local default. Setting DATABASE_URL switches the store
# to PostgreSQL 16, the production-shaped profile.
# DATABASE_URL=postgresql://smb:smb@localhost:5432/smb
SMB_SQLITE_PATH=./data/smb.db

# --- Object store ------------------------------------------------------
# Local filesystem object store by default. Setting SMB_S3_ENDPOINT
# selects the S3-compatible port (compose uses SeaweedFS as `minio`).
SMB_OBJECT_DIR=./data/objects
# SMB_S3_ENDPOINT=http://minio:8333
# SMB_S3_BUCKET=smb-commerce

LOG_LEVEL=INFO
